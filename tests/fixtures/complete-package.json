    "vitest": "^4.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.5.0",
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
